    {
      "name": "with two people the lists switch between them, a new record goes to whoever is in view, unnamed entries can be settled on one person, and archiving one keeps their records",
      "members": {
        "parent": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_elder_care__profiles (id, name, created_by, created_at, updated_at) VALUES ('p-mom', ?, ?, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z')",
          "params": [
            "Mom",
            "{{parent}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_elder_care__profiles (id, name, created_by, created_at, updated_at) VALUES ('p-dad', ?, ?, '2026-01-02T00:00:00Z', '2026-01-02T00:00:00Z')",
          "params": [
            "Dad",
            "{{parent}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_elder_care__tasks (id, profile_id, title, status, created_by, created_by_name, created_at) VALUES ('t-mom', 'p-mom', ?, 'open', ?, ?, '2026-01-03T00:00:00Z')",
          "params": [
            "Refill the pill box",
            "{{parent}}",
            "Parent"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_elder_care__tasks (id, profile_id, title, status, created_by, created_by_name, created_at) VALUES ('t-dad', 'p-dad', ?, 'open', ?, ?, '2026-01-03T00:00:00Z')",
          "params": [
            "Book the eye test",
            "{{parent}}",
            "Parent"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_elder_care__tasks (id, title, status, created_by, created_by_name, created_at) VALUES ('t-house', ?, 'open', ?, ?, '2026-01-03T00:00:00Z')",
          "params": [
            "Fix the porch light",
            "{{parent}}",
            "Parent"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_elder_care__observations (id, member_id, member_name, category, note, observed_at, created_at) VALUES ('o-old', ?, ?, 'mood', ?, strftime('%Y-%m-%dT%H:%M:%fZ','now','-2 days'), strftime('%Y-%m-%dT%H:%M:%fZ','now','-2 days'))",
          "params": [
            "{{parent}}",
            "Parent",
            "Cheerful after lunch"
