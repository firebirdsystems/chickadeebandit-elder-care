          "as": "parent"
        },
        {
          "action": "click",
          "selector": "[data-tab=\"profile\"]",
          "as": "parent"
        },
        {
          "action": "expectText",
          "selector": "[data-testid=\"profile\"] [data-field=\"diet\"]",
          "text": "Low salt",
          "as": "parent"
